server {
  listen 4173;
  server_name localhost;
  proxy_http_version 1.1;

  # Avoid leaking internal port 4173 in redirects when behind a reverse proxy
  absolute_redirect off;
  port_in_redirect off;

  root /usr/share/nginx/html;
  index index.html;

  # Apple Universal Links association file (must be served as application/json)
  location = /.well-known/apple-app-site-association {
    default_type application/json;
    try_files $uri =404;
    include /etc/nginx/security-headers.conf;
  }

  # App deep link landing page — serve without trailing-slash redirect
  location = /open {
    try_files /open/index.html =404;
    include /etc/nginx/security-headers.conf;
  }

  location / {
    try_files $uri $uri/ /index.html;
    include /etc/nginx/security-headers.conf;
  }

  location /api {
    proxy_pass ${VITE_BACKEND_BASE_URL};
    proxy_ssl_server_name on;

    # Logs the path without the query string: the live recitation socket
    # carries its bearer token in `?token=`, and the default `main` format
    # would persist it in plain text on every handshake.
    access_log /var/log/nginx/access.log api_no_query;

    # The live recitation socket lives under /api. `Upgrade` and `Connection`
    # are hop-by-hop headers, so nginx drops them unless they are set again
    # here - without this the handshake comes out the other side as a plain
    # GET and the socket never opens.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # A live puja can run for hours with long quiet stretches between frames,
    # and the default 60s read timeout would cut the socket mid-session.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Library (OpenPecha) API. The trailing slash strips the /library/ prefix, so
  # /library/v2/texts upstream becomes /v2/texts. X-Application is set here
  # rather than by the browser, keeping the upstream host and its required
  # header out of the client entirely.
  location /library/ {
    proxy_pass ${VITE_LIBRARY_BASE_URL}/;
    proxy_ssl_server_name on;

    proxy_set_header Host $proxy_host;
    proxy_set_header X-Application ${VITE_LIBRARY_APP_NAME};

    # Nothing here is user-specific; never forward the caller's credentials.
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
  }

  # Worker API (segment AI chat). The trailing slash strips the /worker/
  # prefix, so /worker/segment-chat/stream upstream becomes
  # /segment-chat/stream. Answers stream as server-sent events, so buffering
  # is off and the read timeout allows for a long answer.
  location /worker/ {
    proxy_pass ${VITE_WORKER_URL}/;
    proxy_ssl_server_name on;

    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The worker's public endpoints don't use the caller's credentials.
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";

    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_connect_timeout 75s;
  }

  location ~ ^/(chats|threads)(/|$) {
    proxy_pass ${VITE_CHAT_API_URL};
    proxy_ssl_server_name on;

    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_ssl_verify off;

    # For streaming responses
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_connect_timeout 75s;
  }
}
